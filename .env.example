# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# ID канала куда отправляются отчёты (например: -1001234567890 или @channel_name)
# Бот должен быть администратором канала с правом постинга
REPORT_CHANNEL_ID=

# API ключ Deepgram для расшифровки голосовых сообщений
# Получить: https://console.deepgram.com
DEEPGRAM_API_KEY=

# Telegram user_id турлидеров через запятую (оставь пустым — доступ открыт всем)
# Узнать свой ID: написать @userinfobot
ALLOWED_USER_IDS=123456789,987654321
